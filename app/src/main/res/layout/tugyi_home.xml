<?xml version="1.0" encoding="utf-8"?>
<!-- Tugyi Pro home, redesign 2026-11-05 (Hsu: change to the design he sent).
     Blue gradient header with a big power button, live Download/Upload
     speed in Mbps, world map, and SG/JP/US selector.
     Home still shows ONLY SG, JP, US. No node list, no IPs, no node names.
     The appbar include is required: ToolbarFragment needs R.id.toolbar. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <!-- Hsu, 2026-11-06 (v1.0.16): the map fills the space so the
         country pill and the Developed line sit at the very bottom
         of the home, above the phone's bottom keys. The LinearLayout
         is match_parent (fillViewport is already true on the
         ScrollView) and the map view takes the leftover height
         (weight 1), so on a tall screen the map grows and the pill
         + Developed are pushed to the bottom; on a short screen the
         ScrollView still scrolls. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/layout_appbar" />

        <!-- Header 320dp (was 400dp): on Hsu's phone the tall header
             pushed the country pill and IP line below the fold
             (2026-11-05 screenshot). Title/menu sit below the status
             bar: the app draws edge-to-edge, so the title was clipped
             by the status bar at marginTop 16dp. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@drawable/tugyi_header_bg">

            <!-- Hamburger inside the blue header, like the design.
                 The pink NekoBox appbar is hidden on this home.
                 Hsu 2026-11-06: HIDE this button (visibility gone), do
                 NOT delete it - view + drawer click listener stay, so
                 it can come back anytime. -->
            <ImageButton
                android:id="@+id/tugyi_menu_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="8dp"
                android:layout_marginTop="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="Menu"
                android:src="@drawable/ic_navigation_menu"
                android:tint="#FFFFFF"
                android:visibility="gone" />

            <!-- No "VPN" title here: Hsu (2026-11-05) does NOT want the
                 title shown at all. The earlier fix (move the button to
                 marginTop 76dp to reveal the title) was reverted - the
                 button stays at its original marginTop 40dp. -->
            <ImageButton
                android:id="@+id/tugyi_power_btn"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="40dp"
                android:background="@drawable/tugyi_power_bg"
                android:contentDescription="Connect / Disconnect"
                android:elevation="8dp"
                android:padding="32dp"
                android:scaleType="fitCenter"
                android:src="@drawable/tugyi_power" />

            <TextView
                android:id="@+id/tugyi_conn_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tugyi_power_btn"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:text="● Disconnected"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </RelativeLayout>

        <!-- Speed header: the label with the connected node's ms beside
             it (Hsu, 2026-11-05): "Speed  245 ms" when connected, dashes
             when disconnected. Same view id (tugyi_ping) as before, only
             moved here from under the country pill, so refreshPing()
             needs no change. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speed"
                android:textColor="#9E9E9E"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tugyi_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="--"
                android:textColor="#1E88E5"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download"
                    android:textColor="#1E88E5"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tugyi_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#212121"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tugyi_download_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="mbps"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="80dp"
                android:layout_gravity="center_vertical"
                android:background="#E0E0E0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    android:textColor="#1E88E5"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tugyi_upload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#212121"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tugyi_upload_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="mbps"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Location"
            android:textColor="#9E9E9E"
            android:textSize="16sp" />

        <!-- Route map: Myanmar origin dot, destination dot, and an
             animated route line Myanmar -> SG/JP/US while connected.
             v1.0.16 (Hsu, 2026-11-06): height 0dp + weight 1, so the
             map fills the space between Location and the bottom
             pill instead of a fixed 150dp. -->
        <io.nekohasekai.sagernet.tugyi.TugyiRouteMapView
            android:id="@+id/tugyi_map"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:contentDescription="World map with route" />

        <!-- Country pill only, exactly like the design (Hsu, 2026-11-05).
             No separate SG/JP/US buttons: regions are NOT hardcoded in
             the layout. Tapping the pill opens the region list, built
             from TugyiCountry.all() - adding a region later only needs
             one entry in TugyiCountries.kt. -->
        <TextView
            android:id="@+id/tugyi_country_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/tugyi_country_pill"
            android:paddingLeft="28dp"
            android:paddingTop="10dp"
            android:paddingRight="28dp"
            android:paddingBottom="10dp"
            android:text="🇸🇬 Singapore"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Credit line at the very bottom of the home (Hsu, 2026-11-05). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Developed by ဖီးနစ် (ထူးကြီး)"
            android:textColor="#9E9E9E"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
