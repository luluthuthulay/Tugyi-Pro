<?xml version="1.0" encoding="utf-8"?>
<!-- Tugyi Pro home: ONLY three country buttons, plus a status line.
     No node list, no IPs, no node names on home. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_appbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <Button
            android:id="@+id/btn_sg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SG" />

        <Button
            android:id="@+id/btn_jp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JP" />

        <Button
            android:id="@+id/btn_us"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="US" />

        <TextView
            android:id="@+id/tugyi_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Tap SG, JP or US to connect" />

    </LinearLayout>
</LinearLayout>
